---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BubbleMenu from '@/components/BubbleMenu'
import BlogReadingNudge from '@/components/BlogReadingNudge'
import { BlogVector } from '@/components/BlogVectors'
import { Footer } from '@/sections/Footer'
import { blogPosts } from '@/data/blogPosts'
import { formatPostDate, profile } from '@/data/content'

export function getStaticPaths() {
  const sorted = [...blogPosts].sort((a, b) => b.date.localeCompare(a.date))

  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      next: sorted[(index + 1) % sorted.length],
      // Chosen at build time: a different recent post to offer a skimmer.
      suggestion: sorted.filter((p) => p.slug !== post.slug).slice(0, 4)[0],
    },
  }))
}

const { post, next, suggestion } = Astro.props
const site = Astro.site?.toString().replace(/\/$/, '') ?? ''
const url = `${site}/blog/${post.slug}`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  keywords: [post.topic, ...post.tags].join(', '),
  articleSection: post.topic,
  wordCount: post.body.join(' ').split(/\s+/).length,
  timeRequired: `PT${post.readingMinutes}M`,
  inLanguage: 'en',
  author: { '@type': 'Person', name: profile.name, url: site },
  publisher: { '@type': 'Person', name: profile.brand, url: site },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'Blog', name: `${profile.name} — Blog`, url: `${site}/blog` },
}
---

<BaseLayout
  title={`${post.title} — ${profile.name}`}
  description={post.excerpt}
  path={`/blog/${post.slug}`}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.date}
  jsonLd={jsonLd}
>
  <div class="bg-white" style="overflow-x: clip">
    <BubbleMenu client:load />

    <main class="min-h-svh bg-white px-4 pt-36 pb-28 sm:px-8 lg:px-12 xl:px-16">
      <article class="mx-auto max-w-[720px]">
        <a
          href="/blog"
          class="font-body inline-flex items-center gap-2 text-[13px] font-bold tracking-wide text-black/60 uppercase transition-colors hover:text-black"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          All blogs
        </a>

        <header class="mt-8">
          <div class="font-body flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] tracking-wide text-black/50 uppercase">
            <time datetime={post.date}>{formatPostDate(post.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.readingMinutes} min read</span>
            <span aria-hidden="true">·</span>
            <span>{post.topic}</span>
          </div>

          <h1 class="font-body mt-4 text-[clamp(2rem,5vw,56px)] leading-[1.15] font-semibold text-black">
            {post.title}
          </h1>
          <p class="font-body mt-5 text-[clamp(1.05rem,1.5vw,1.3rem)] leading-[1.6] text-black/70">
            {post.excerpt}
          </p>

          <div class="mt-8 aspect-[384/240] w-full overflow-hidden border border-black bg-white">
            <BlogVector name={post.vector} />
          </div>
        </header>

        <div class="font-body mt-12 space-y-6">
          {
            post.body.map((paragraph) => (
              <p class="text-[17px] leading-[1.75] text-black/85">{paragraph}</p>
            ))
          }
        </div>

        <div class="mt-14 flex flex-wrap gap-2 border-t border-black/15 pt-8">
          {
            post.tags.map((tag) => (
              <span class="font-body rounded-full border border-black/20 px-3 py-1 text-[12px] tracking-wide text-black/60 uppercase">
                {tag}
              </span>
            ))
          }
        </div>

        <nav
          aria-label="Where to go next"
          class="mt-12 grid gap-4 border-t border-black/15 pt-8 sm:grid-cols-2"
        >
          <a
            href={`/blog/${next.slug}`}
            class="group flex h-full flex-col justify-between gap-6 border border-black bg-white p-5 transition-colors hover:bg-black sm:p-6"
          >
            <span class="font-body text-[11px] font-bold tracking-[1.2px] text-black/40 uppercase group-hover:text-white/60">
              Read next
            </span>
            <span class="font-body flex items-start justify-between gap-3 text-[clamp(1.05rem,2vw,1.35rem)] leading-[1.3] font-bold text-black group-hover:text-white">
              {next.title}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-1 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </span>
          </a>

          <a
            href="/#work"
            class="group flex h-full flex-col justify-between gap-6 border border-black bg-black p-5 transition-colors hover:bg-white sm:p-6"
          >
            <span class="font-body text-[11px] font-bold tracking-[1.2px] text-white/50 uppercase group-hover:text-black/40">
              Or
            </span>
            <span class="font-body flex items-start justify-between gap-3 text-[clamp(1.05rem,2vw,1.35rem)] leading-[1.3] font-bold text-white group-hover:text-black">
              See the work
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-1 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </span>
          </a>
        </nav>
      </article>
    </main>

    <Footer />
    <BlogReadingNudge client:idle suggestion={suggestion} />
  </div>
</BaseLayout>
